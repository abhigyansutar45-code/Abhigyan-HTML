        function openCustomModal(title, content) {

            document.getElementById("modalContent").innerHTML = `

                <h2 id="modalTitle">${escapeHTML(title)}</h2>

                <p>TravelSphere interactive demonstration</p>

                ${content}

            `;

            document.getElementById("mainModal").classList.add("show");

        }


        function closeModal() {

            document.getElementById("mainModal").classList.remove("show");

        }


        /* =========================================
           SAFE TEXT DISPLAY
        ========================================= */

        function escapeHTML(value) {

            return String(value).replace(/[&<>"']/g, function(char) {

                return {
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#39;"
                }[char];

            });

        }


        /* =========================================
           DASHBOARD
        ========================================= */

        function updateDashboard() {

            document.getElementById("bookingCount").textContent =
                bookings.length;

            document.getElementById("favoriteCount").textContent =
                favorites.length;

            document.getElementById("tripCount").textContent =
                bookings.length;

            const total = bookings.reduce(
                (sum, booking) => sum + Number(booking.total || 0),
                0
            );

            document.getElementById("bookingTotal").textContent =
                "₹" + total.toLocaleString("en-IN");

            const list = document.getElementById("tripList");

            if (bookings.length === 0) {

                list.innerHTML = `

                    <h3 style="color:var(--navy);margin-bottom:12px">
                        Your Bookings
                    </h3>

                    <p style="color:var(--muted);font-size:14px">
                        No bookings yet. Explore a hotel or package
                        to try the demo booking flow.
                    </p>

                `;

                return;

            }

            list.innerHTML = `

                <h3 style="color:var(--navy);margin-bottom:15px">
                    Your Demo Bookings
                </h3>

                ${bookings.map(booking => `

                    <div style="
                        padding:15px;
                        border:1px solid #e5edf5;
                        border-radius:10px;
                        margin-bottom:12px;
                    ">

                        <strong>${escapeHTML(booking.name)}</strong>

                        <p style="font-size:12px;color:#748398;margin-top:7px">
                            ${escapeHTML(booking.type)}
                            · ${escapeHTML(booking.date)}
                        </p>

                        <p style="font-size:12px;color:#748398;margin-top:5px">
                            Reference: ${escapeHTML(booking.reference)}
                        </p>

                        <p style="font-weight:800;color:#1677D2;margin-top:7px">
                            ₹${Number(booking.total).toLocaleString("en-IN")}
                        </p>

                    </div>

                `).join("")}

            `;

        }


        function showTrips() {

            updateDashboard();

            showToast("Travel dashboard updated.");

        }


        /* =========================================
           DATE VALIDATION DEFAULTS
        ========================================= */

        const today = new Date();

        const todayString = [
            today.getFullYear(),
            String(today.getMonth() + 1).padStart(2, "0"),
            String(today.getDate()).padStart(2, "0")
        ].join("-");

        function setDateLimits() {

            document.querySelectorAll('input[type="date"]').forEach(input => {

                input.min = todayString;

            });

        }


        /* =========================================
           INITIALISE APPLICATION
        ========================================= */

        document.addEventListener("DOMContentLoaded", function() {

            updateDashboard();

            setDateLimits();

            favorites.forEach(destination => {

                const buttons = document.querySelectorAll(".heart-btn");

                buttons.forEach(button => {

                    if (button.getAttribute("onclick").includes(
                        "'" + destination + "'"
                    )) {

                        button.classList.add("saved");

                        button.textContent = "♥";

                    }

                });

            });

            console.log("TravelSphere initialized successfully.");

        });

    </script>

</body>
</html>
