                    <div class="field">
                        <label>DEPARTURE DATE</label>
                        <input type="date" id="checkin" required>
                    </div>

                    <div class="field">
                        <label>TRIP TYPE</label>
                        <select id="tripType">
                            <option>Round Trip</option>
                            <option>One Way</option>
                        </select>
                    </div>
                `;

            } else if (tab === "packages") {

                html = `
                    <div class="field">
                        <label>DESTINATION</label>
                        <input id="searchDestination"
                        placeholder="Choose destination" required>
                    </div>

                    <div class="field">
                        <label>START DATE</label>
                        <input type="date" id="checkin" required>
                    </div>

                    <div class="field">
                        <label>TRAVELLERS</label>
                        <select id="guests">
                            <option>1 Traveller</option>
                            <option selected>2 Travellers</option>
                            <option>3 Travellers</option>
                            <option>4 Travellers</option>
                        </select>
                    </div>

                    <div class="field">
                        <label>PACKAGE TYPE</label>
                        <select id="packageType">
                            <option>Adventure</option>
                            <option>Luxury</option>
                            <option>Family</option>
                            <option>Budget</option>
                        </select>
                    </div>
                `;

            } else {

                html = `
                    <div class="field">
                        <label>DESTINATION</label>
                        <input id="searchDestination"
                        placeholder="Where to?" required>
                    </div>

                    <div class="field">
                        <label>EXPERIENCE</label>
                        <select id="experienceType">
                            <option>Adventure</option>
                            <option>Food & Culture</option>
                            <option>Nature</option>
                            <option>Sightseeing</option>
                        </select>
                    </div>

                    <div class="field">
                        <label>DATE</label>
                        <input type="date" id="checkin" required>
                    </div>

                    <div class="field">
                        <label>PARTICIPANTS</label>
                        <select id="guests">
                            <option>1 Person</option>
                            <option selected>2 People</option>
                            <option>3 People</option>
                            <option>4 People</option>
                        </select>
                    </div>
