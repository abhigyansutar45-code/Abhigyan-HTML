                class="primary-btn search-submit">
                    Search →
                </button>
            `;

        }


        /* =========================================
           SEARCH VALIDATION
        ========================================= */

        document.getElementById("searchForm").addEventListener(
            "submit",
            function(event) {

                event.preventDefault();

                const destination =
                    document.getElementById("searchDestination").value.trim();

                if (!destination) {
                    showToast("Please enter a destination.");
                    return;
                }

                const checkin =
                    document.getElementById("checkin");

                const checkout =
                    document.getElementById("checkout");

                if (checkin && checkin.value) {

                    const today = new Date();

                    today.setHours(0,0,0,0);

                    const start = new Date(checkin.value + "T00:00:00");

                    if (start < today) {
                        showToast("Please select today or a future date.");
                        return;
                    }

                    if (checkout && checkout.value) {

                        const end = new Date(checkout.value + "T00:00:00");

                        if (end <= start) {
                            showToast("Check-out must be after check-in.");
                            return;
                        }
                    }
                }

                if (currentTab === "flights") {

                    const arrival =
                        document.getElementById("flightDestination").value.trim();

                    if (!arrival) {
                        showToast("Please enter an arrival city.");
                        return;
                    }

                    if (arrival.toLowerCase() === destination.toLowerCase()) {
                        showToast("Origin and destination must be different.");
                        return;
                    }
                }

                showToast(
                    "Showing demonstration " + currentTab +
                    " results for " + destination + "."
                );

                if (currentTab === "stays") {
                    document.getElementById("hotels").scrollIntoView();
                }

                if (currentTab === "packages") {
                    document.getElementById("packages").scrollIntoView();
                }

                if (currentTab === "experiences") {
                    document.getElementById("experiences").scrollIntoView();
                }

                if (currentTab === "flights") {
                    document.getElementById("flights").scrollIntoView();
                }

            }
        );


        /* =========================================
           FAVOURITES
        ========================================= */

        function toggleFavorite(button, destination) {

            if (favorites.includes(destination)) {

                favorites = favorites.filter(
                    item => item !== destination
                );

                button.classList.remove("saved");

                button.textContent = "♡";

                showToast(destination + " removed from favourites.");

            } else {

                favorites.push(destination);

                button.classList.add("saved");

                button.textContent = "♥";

                showToast(destination + " added to favourites.");

            }

            localStorage.setItem(
                "ts_favorites",
                JSON.stringify(favorites)
            );

            updateDashboard();

        }


        /* =========================================
