
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="TravelSphere - Discover destinations, explore hotels and plan unforgettable journeys around the world.">
    <meta name="theme-color" content="#10243A">
    <title>TravelSphere | Explore Beyond Boundaries</title>

    <!-- ORIGINAL TRAVELSPHERE FAVICON -->
    <link rel="icon" type="image/svg+xml"
    href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='24' fill='%2310243A'/%3E%3Ccircle cx='50' cy='50' r='29' fill='none' stroke='%2355B8F5' stroke-width='5'/%3E%3Cpath d='M21 50h58M50 21c-16 16-16 42 0 58M50 21c16 16 16 42 0 58' fill='none' stroke='%23FF9D45' stroke-width='4' stroke-linecap='round'/%3E%3Cpath d='M48 8l8 12-8 4-8-4z' fill='%23FF9D45'/%3E%3C/svg%3E">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        /* =========================================
           TRAVELSPHERE - MAIN DESIGN SYSTEM
        ========================================= */

        :root {
            --navy: #10243A;
            --blue: #1677D2;
            --sky: #55B8F5;
            --orange: #FF9D45;
            --green: #16A36A;
            --white: #FFFFFF;
            --background: #F5F8FC;
            --grey: #E9EEF4;
            --text: #25364A;
            --muted: #748398;
            --shadow: 0 12px 35px rgba(16,36,58,.09);
            --radius: 18px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 90px;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--background);
            color: var(--text);
            overflow-x: hidden;
        }

        button, input, select, textarea {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        img {
            width: 100%;
            display: block;
            object-fit: cover;
        }

        .container {
            width: min(1180px, 92%);
            margin: auto;
        }

        .section {
            padding: 85px 0;
        }

        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 20px;
            margin-bottom: 32px;
        }

        .eyebrow {
            color: var(--blue);
            text-transform: uppercase;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 2px;
            margin-bottom: 10px;
        }

        .section-heading h2 {
            font-family: 'Manrope', sans-serif;
            color: var(--navy);
            font-size: clamp(26px, 4vw, 38px);
            font-weight: 800;
        }

        .section-heading p {
            color: var(--muted);
            margin-top: 8px;
        }

        .primary-btn {
            background: var(--blue);
            color: white;
            padding: 13px 21px;
            border: none;
            border-radius: 10px;
            font-weight: 700;
            transition: .25s;
        }

        .primary-btn:hover {
            background: var(--navy);
            transform: translateY(-2px);
        }

        .outline-btn {
            border: 1px solid #dce5ee;
            background: white;
            color: var(--navy);
            padding: 12px 19px;
            border-radius: 10px;
            font-weight: 700;
        }

        .outline-btn:hover {
            border-color: var(--blue);
            color: var(--blue);
        }

        /* =========================================
           NAVIGATION
        ========================================= */

        .navbar {
            height: 78px;
            background: rgba(255,255,255,.96);
            backdrop-filter: blur(15px);
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 18px rgba(16,36,58,.06);
        }

        .nav-inner {
            height: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--navy);
            font-family: 'Manrope', sans-serif;
            font-size: 24px;
            font-weight: 800;
            white-space: nowrap;
        }

        .logo-icon {
            height: 43px;
            width: 43px;
            display: grid;
            place-items: center;
            background: var(--navy);
            border-radius: 13px;
            color: var(--sky);
            font-size: 23px;
        }

        .logo span:last-child {
            color: var(--blue);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 22px;
            list-style: none;
        }

        .nav-links a {
            font-size: 13px;
            font-weight: 700;
            color: #536579;
            transition: .2s;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: var(--blue);
        }

        .nav-actions {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .login-btn {
            background: transparent;
            border: none;
            font-weight: 700;
            color: var(--navy);
            padding: 10px;
        }

        .join-btn {
            background: var(--navy);
            color: white;
            padding: 11px 17px;
            border: none;
            border-radius: 9px;
            font-weight: 700;
        }

        .menu-toggle {
            display: none;
            background: none;
            border: none;
            color: var(--navy);
            font-size: 28px;
        }

        /* =========================================
           HERO
        ========================================= */

        .hero {
            min-height: 630px;
            position: relative;
            background:
                linear-gradient(90deg, rgba(7,24,43,.82), rgba(7,24,43,.28)),
                url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=2000')
                center/cover;
            display: flex;
            align-items: center;
            color: white;
        }

        .hero-content {
            padding: 80px 0 145px;
        }

        .hero-tag {
            display: inline-block;
            background: rgba(255,255,255,.15);
            border: 1px solid rgba(255,255,255,.3);
            backdrop-filter: blur(8px);
            padding: 9px 15px;
            border-radius: 30px;
            font-size: 12px;
            letter-spacing: 1px;
            margin-bottom: 23px;
        }

        .hero h1 {
            font-family: 'Manrope', sans-serif;
            font-size: clamp(42px, 6vw, 72px);
            line-height: 1.1;
            max-width: 720px;
            font-weight: 800;
        }

        .hero h1 span {
            color: var(--sky);
        }

        .hero p {
            max-width: 580px;
            color: #e3edf7;
            line-height: 1.8;
            margin-top: 20px;
            font-size: 16px;
        }

        .hero-buttons {
            display: flex;
            gap: 13px;
            margin-top: 28px;
        }

        .hero-buttons .primary-btn {
            background: var(--orange);
            color: var(--navy);
        }

        .hero-buttons .outline-btn {
            background: rgba(255,255,255,.13);
            color: white;
            border-color: rgba(255,255,255,.4);
        }

        /* =========================================
           SEARCH PANEL
        ========================================= */

        .search-wrap {
            position: relative;
            z-index: 10;
            margin-top: -90px;
        }

        .search-panel {
            background: white;
            padding: 25px;
            border-radius: 19px;
            box-shadow: var(--shadow);
        }

        .search-tabs {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 24px;
        }

        .search-tab {
            border: none;
            background: #f1f5f9;
            padding: 12px 18px;
            border-radius: 9px;
            color: #62748a;
            font-weight: 700;
        }

        .search-tab.active {
            background: var(--navy);
            color: white;
        }

        .search-fields {
            display: grid;
            grid-template-columns: repeat(4, 1fr) auto;
            gap: 12px;
            align-items: end;
        }

        .field label {
            display: block;
            font-size: 12px;
            color: var(--muted);
            font-weight: 700;
            margin-bottom: 8px;
        }

        .field input,
        .field select {
            width: 100%;
            min-width: 0;
            padding: 13px 12px;
            border: 1px solid #dce5ee;
            border-radius: 9px;
            outline: none;
            background: white;
            color: var(--navy);
        }

        .field input:focus,
        .field select:focus {
            border-color: var(--blue);
            box-shadow: 0 0 0 3px rgba(22,119,210,.1);
        }

        .search-submit {
            min-height: 45px;
            white-space: nowrap;
        }

        /* =========================================
           DESTINATIONS
        ========================================= */

        .destination-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .destination-card {
            background: white;
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: .3s;
        }

        .destination-card:hover {
            transform: translateY(-7px);
        }

        .destination-image {
            height: 210px;
            position: relative;
            overflow: hidden;
        }

        .destination-image img {
            height: 100%;
            transition: .5s;
        }

        .destination-card:hover img {
            transform: scale(1.07);
        }

        .price-tag {
            position: absolute;
            bottom: 13px;
            left: 13px;
            background: white;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 800;
            color: var(--navy);
        }

        .destination-info {
            padding: 18px;
        }

        .destination-info h3 {
            font-family: 'Manrope', sans-serif;
            font-size: 19px;
            color: var(--navy);
        }

        .destination-info p {
            color: var(--muted);
            font-size: 13px;
            margin: 8px 0 15px;
            line-height: 1.6;
        }

        .card-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }

        .text-link {
            border: none;
            background: none;
            color: var(--blue);
            font-weight: 800;
            font-size: 13px;
        }

        .heart-btn {
            border: none;
            background: #f1f5f9;
            border-radius: 50%;
            height: 36px;
            width: 36px;
            font-size: 17px;
        }

        .heart-btn.saved {
            background: #ffe9e9;
            color: #e34d62;
        }

        /* =========================================
           PROMO BANNER
        ========================================= */

        .promo {
            padding: 45px;
            border-radius: 22px;
            background:
                linear-gradient(100deg, rgba(16,36,58,.94), rgba(16,36,58,.55)),
                url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1400')
                center/cover;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 25px;
        }

        .promo h2 {
            font-family: 'Manrope', sans-serif;
            font-size: clamp(25px, 4vw, 38px);
            max-width: 570px;
        }

        .promo p {
            color: #dce8f5;
            margin-top: 10px;
        }

        .promo .primary-btn {
            background: var(--orange);
            color: var(--navy);
            white-space: nowrap;
        }

        /* =========================================
           HOTELS
        ========================================= */

        .hotel-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
        }

        .hotel-card {
            background: white;
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: .3s;
        }

        .hotel-card:hover {
            transform: translateY(-5px);
        }

        .hotel-image {
            height: 220px;
            position: relative;
        }

        .hotel-image img {
            height: 100%;
        }

        .rating {
            position: absolute;
            top: 13px;
            right: 13px;
            background: white;
            border-radius: 7px;
            padding: 7px 10px;
            font-size: 12px;
            font-weight: 800;
            color: var(--navy);
        }

        .hotel-info {
            padding: 20px;
        }

        .hotel-info h3 {
            font-size: 19px;
            color: var(--navy);
        }

        .hotel-location {
            color: var(--muted);
            font-size: 13px;
            margin: 9px 0;
        }

        .amenities {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin: 14px 0;
        }

        .amenities span {
            background: #f0f5fa;
            color: #526b82;
            font-size: 11px;
            padding: 7px 9px;
            border-radius: 6px;
        }

        .hotel-price {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 14px;
            border-top: 1px solid #edf1f5;
        }

        .hotel-price strong {
            color: var(--navy);
            font-size: 21px;
        }

        .hotel-price small {
            color: var(--muted);
            font-size: 11px;
        }

        /* =========================================
           EXPERIENCES
        ========================================= */

        .experience-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 17px;
        }

        .experience-card {
            min-height: 230px;
            position: relative;
            overflow: hidden;
            border-radius: 16px;
            color: white;
        }

        .experience-card img {
            height: 100%;
            position: absolute;
            inset: 0;
            transition: .4s;
        }

        .experience-card:hover img {
            transform: scale(1.08);
        }

        .experience-card::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(transparent, rgba(0,0,0,.8));
        }

        .experience-card div {
            position: absolute;
            z-index: 2;
            bottom: 20px;
            left: 18px;
        }

        .experience-card h3 {
            font-size: 19px;
        }

        .experience-card p {
            font-size: 12px;
            color: #e2eaf2;
            margin-top: 6px;
        }

        /* =========================================
           PACKAGES
        ========================================= */

        .package-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .package-card {
            background: white;
            padding: 23px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            border: 1px solid #edf1f5;
        }

        .package-icon {
            width: 48px;
            height: 48px;
            display: grid;
            place-items: center;
            border-radius: 14px;
            background: #eaf4ff;
            font-size: 23px;
            margin-bottom: 17px;
        }

        .package-card h3 {
            color: var(--navy);
            font-size: 19px;
        }

        .package-card p {
            color: var(--muted);
            font-size: 13px;
            line-height: 1.7;
            margin: 10px 0 18px;
        }

        .package-card strong {
            color: var(--blue);
            font-size: 20px;
        }

        /* =========================================
           WHY TRAVELSPHERE
        ========================================= */

        .features {
            background: #edf5fc;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .feature {
            background: white;
            padding: 25px;
            border-radius: 16px;
            text-align: center;
            box-shadow: 0 5px 20px rgba(16,36,58,.04);
        }

        .feature-icon {
            font-size: 31px;
            margin-bottom: 14px;
        }

        .feature h3 {
            color: var(--navy);
            font-size: 16px;
            margin-bottom: 9px;
        }

        .feature p {
            color: var(--muted);
            font-size: 13px;
            line-height: 1.6;
        }

        /* =========================================
           TESTIMONIALS
        ========================================= */

        .testimonial-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .testimonial {
            padding: 25px;
            border-radius: 16px;
            background: white;
            box-shadow: var(--shadow);
        }

        .stars {
            color: #f5a623;
            letter-spacing: 3px;
        }

        .testimonial p {
            color: #64758a;
            line-height: 1.8;
            font-size: 14px;
            margin: 15px 0;
        }

        .testimonial strong {
            color: var(--navy);
        }

        .demo-label {
            font-size: 10px;
            color: var(--muted);
            display: block;
            margin-top: 8px;
        }

        /* =========================================
           NEWSLETTER
        ========================================= */

        .newsletter {
            background: var(--navy);
            padding: 55px 20px;
            text-align: center;
            color: white;
        }

        .newsletter h2 {
            font-family: 'Manrope', sans-serif;
            font-size: 31px;
        }

        .newsletter p {
            color: #c4d3e3;
            margin: 12px 0 24px;
        }

        .newsletter-form {
            display: flex;
            max-width: 500px;
            margin: auto;
            gap: 10px;
        }

        .newsletter-form input {
            flex: 1;
            min-width: 0;
            padding: 14px;
            border: none;
            border-radius: 9px;
            outline: none;
        }

        /* =========================================
           FOOTER
        ========================================= */

        footer {
            background: #091827;
            color: white;
            padding: 60px 0 20px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 35px;
            padding-bottom: 40px;
        }

        .footer-about p {
            color: #a8bacd;
            font-size: 13px;
            line-height: 1.8;
            margin-top: 18px;
            max-width: 310px;
        }

        footer h4 {
            margin-bottom: 17px;
            font-size: 15px;
        }

        footer ul {
            list-style: none;
        }

        footer li {
            margin-bottom: 12px;
            color: #a8bacd;
            font-size: 13px;
        }

        footer a:hover {
            color: var(--sky);
        }

        .footer-bottom {
            border-top: 1px solid #26394c;
            padding-top: 20px;
            display: flex;
            justify-content: space-between;
            gap: 15px;
            color: #9eb0c3;
            font-size: 12px;
        }

        /* =========================================
           MODAL
        ========================================= */

        .modal {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 2000;
            background: rgba(5,17,29,.68);
            padding: 20px;
            align-items: center;
            justify-content: center;
        }

        .modal.show {
            display: flex;
        }

        .modal-box {
            width: min(520px, 100%);
            max-height: 90vh;
            overflow-y: auto;
            background: white;
            padding: 30px;
            border-radius: 18px;
            position: relative;
            animation: appear .25s ease;
        }

        @keyframes appear {
            from {
                opacity: 0;
                transform: translateY(15px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .modal-close {
            position: absolute;
            right: 17px;
            top: 15px;
            border: none;
            background: #edf2f7;
            border-radius: 50%;
            width: 35px;
            height: 35px;
            font-size: 20px;
        }

        .modal-box h2 {
            color: var(--navy);
            margin-bottom: 8px;
            padding-right: 30px;
        }

        .modal-box > p {
            color: var(--muted);
            font-size: 13px;
            margin-bottom: 20px;
        }

        .modal-form {
            display: grid;
            gap: 13px;
        }

        .modal-form label {
            font-size: 12px;
            font-weight: 700;
            color: var(--navy);
        }

        .modal-form input,
        .modal-form select,
        .modal-form textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #dce5ee;
            border-radius: 8px;
            margin-top: 7px;
            outline: none;
        }

        .modal-form input:focus,
        .modal-form select:focus,
        .modal-form textarea:focus {
            border-color: var(--blue);
        }

        .confirmation {
            padding: 20px;
            background: #eaf8f0;
            border-radius: 12px;
            color: #176b46;
            line-height: 1.8;
        }

        /* =========================================
           TOAST
        ========================================= */

        .toast {
            position: fixed;
            bottom: 25px;
            right: 25px;
            z-index: 3000;
            background: var(--navy);
            color: white;
            padding: 15px 20px;
            border-radius: 10px;
            box-shadow: var(--shadow);
            opacity: 0;
            transform: translateY(20px);
            pointer-events: none;
            transition: .3s;
            max-width: min(350px, calc(100% - 40px));
        }

        .toast.show {
            opacity: 1;
            transform: translateY(0);
        }

        .demo-notice {
            background: #fff6e9;
            color: #80511b;
            padding: 11px;
            text-align: center;
            font-size: 12px;
            font-weight: 600;
        }

        /* =========================================
           RESPONSIVE DESIGN
        ========================================= */

        @media(max-width: 1050px) {
            .nav-links {
                gap: 12px;
            }

            .nav-links a {
                font-size: 11px;
            }

            .destination-grid,
            .experience-grid,
            .feature-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .search-fields {
                grid-template-columns: repeat(2, 1fr);
            }

            .search-submit {
                width: 100%;
            }
        }

        @media(max-width: 760px) {
            .navbar {
                height: 68px;
            }

            .menu-toggle {
                display: block;
            }

            .nav-links {
                display: none;
                position: absolute;
                top: 68px;
                left: 0;
                width: 100%;
                background: white;
                padding: 20px 5%;
                flex-direction: column;
                align-items: flex-start;
                box-shadow: var(--shadow);
            }

            .nav-links.open {
                display: flex;
            }

            .nav-links li {
                width: 100%;
                padding: 8px 0;
            }

            .nav-links a {
                font-size: 14px;
            }

            .nav-actions {
                display: none;
            }

            .hero {
                min-height: 570px;
            }

            .hero-content {
                padding-bottom: 130px;
            }

            .section {
                padding: 60px 0;
            }

            .section-heading {
                align-items: flex-start;
