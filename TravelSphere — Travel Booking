            currentBooking = {
                name: name,
                price: price,
                type: "Holiday Package"
            };

            openBookingForm();

        }


        /* =========================================
           BOOKING FORM
        ========================================= */

        function openBookingForm() {

            if (!currentBooking) return;

            openCustomModal(
                "Complete Your Demo Booking",

                `
                    <p>
                        Selected: <strong>${escapeHTML(currentBooking.name)}</strong>
                    </p>

                    <div class="confirmation" style="margin-bottom:18px">
                        <strong>Estimated demo price:</strong>
                        ₹${currentBooking.price.toLocaleString("en-IN")}

                        <br>

                        <small>
                            No payment will be collected.
                        </small>
                    </div>

                    <form class="modal-form" id="bookingForm">

                        <label>
                            Full Name
                            <input type="text" id="travellerName"
                            placeholder="Enter your full name"
                            maxlength="80" required>
                        </label>

                        <label>
                            Email Address
                            <input type="email" id="travellerEmail"
                            placeholder="Enter your email"
                            maxlength="120" required>
                        </label>

                        <label>
                            Number of Travellers
                            <select id="travellerCount">
                                <option value="1">1 Traveller</option>
                                <option value="2" selected>2 Travellers</option>
                                <option value="3">3 Travellers</option>
                                <option value="4">4 Travellers</option>
                            </select>
                        </label>

                        <button type="submit" class="primary-btn">
                            Confirm Demo Booking →
                        </button>

                    </form>
                `
            );

            document.getElementById("bookingForm").addEventListener(
                "submit",
                function(event) {

                    event.preventDefault();

                    const name =
                        document.getElementById("travellerName").value.trim();

                    const email =
                        document.getElementById("travellerEmail").value.trim();

                    const count =
                        Number(document.getElementById("travellerCount").value);

                    if (!name || !email || !email.includes("@")) {
                        showToast("Please enter valid traveller details.");
                        return;
                    }

                    const total = currentBooking.price * count;

                    const booking = {

                        reference: "TS" +
                            Date.now().toString().slice(-8),

                        name: currentBooking.name,

                        type: currentBooking.type,

                        traveller: name,

                        email: email,

                        people: count,

                        total: total,

                        date: new Date().toLocaleDateString("en-IN")

                    };

                    bookings.push(booking);

                    localStorage.setItem(
                        "ts_bookings",
                        JSON.stringify(bookings)
                    );

                    updateDashboard();

                    document.getElementById("modalContent").innerHTML = `

                        <div style="text-align:center">

                            <div style="font-size:55px">✅</div>

                            <h2 id="modalTitle">
                                Demo Booking Confirmed!
                            </h2>

                            <p>
                                Your demonstration booking has been recorded
                                in this browser.
                            </p>

                        </div>

                        <div class="confirmation">

                            <strong>Booking Reference:</strong>
                            ${escapeHTML(booking.reference)}

                            <br>

                            <strong>Service:</strong>
                            ${escapeHTML(booking.name)}

                            <br>

                            <strong>Traveller:</strong>
                            ${escapeHTML(booking.traveller)}

                            <br>

                            <strong>Travellers:</strong>
                            ${booking.people}

                            <br>

                            <strong>Estimated Total:</strong>
                            ₹${booking.total.toLocaleString("en-IN")}

                            <br><br>

                            <small>
                                This is not a real travel reservation or
                                payment confirmation.
                            </small>

                        </div>

                        <button class="primary-btn"
                        style="width:100%;margin-top:20px"
                        onclick="closeModal();document.getElementById('mytrips').scrollIntoView()">
                            View My Trips
                        </button>

                    `;

                    showToast("Demo booking saved successfully!");

                }
            );

        }


        /* =========================================
           FLIGHT SEARCH
        ========================================= */

        document.getElementById("flightForm").addEventListener(
